{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recipio",
  "version": "0.1.0",
  "identifier": "io.github.bvdon.recipio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Recipio",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob: recipio-media: http://recipio-media.localhost",
        "media-src": "'self' recipio-media: http://recipio-media.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "bvdon",
    "homepage": "https://github.com/bvdon/recipio",
    "copyright": "Copyright © 2026 bvdon. MIT License.",
    "license": "MIT",
    "category": "Lifestyle",
    "shortDescription": "A local-first recipe app",
    "longDescription": "Recipio keeps your recipes on your own computer: photos, structured ingredients, steps, offline YouTube videos, web import, cooking mode, PDF and backups. No accounts, no cloud.",
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "recipio"
        ],
        "name": "Recipio recipes",
        "description": "Recipes shared from Recipio",
        "role": "Viewer",
        "rank": "Owner",
        "mimeType": "application/x-recipio",
        "contentTypes": [
          "io.github.bvdon.recipio.recipes"
        ],
        "exportedType": {
          "identifier": "io.github.bvdon.recipio.recipes",
          "conformsTo": [
            "public.data"
          ]
        }
      }
    ]
  }
}
